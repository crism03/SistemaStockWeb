@model IEnumerable<SistemaStockWeb.Models.ViewModels.Usuario.UsuarioViewModel>
@{
    ViewData["Title"] = "Usuarios";
    ViewData["SubTitle"] = "Listado de usuarios";
}

<div class="d-flex justify-content-end align-items-center mb-3">
    <a asp-action="Crear" class="btn btn-sm btn-outline-primary">
        <i class="bi bi-plus"></i> Nuevo usuario
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle" id="miTabla">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Email</th>
                <th>Rol</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in Model)
            {
                <tr>
                    <td>@usuario.Nombre</td>
                    <td>@usuario.Email</td>
                    <td><span class="badge text-bg-info">@usuario.Rol</span></td>
                    <td>
                        @if (usuario.Activo)
                        {
                            <span class="badge text-bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Editar" asp-route-id="@usuario.Id"
                           class="btn btn-sm btn-outline-primary" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="ResetearPassword" asp-route-id="@usuario.Id"
                           class="btn btn-sm btn-outline-warning" title="Resetear contraseña">
                            <i class="bi bi-key"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@model SistemaStockWeb.Models.ViewModels.Movimiento.OperacionStockEntradaViewModel
@{
    ViewData["Title"] = "Movimientos";
    ViewData["SubTitle"] = "Registrar entrada de stock";
}

<form asp-action="Entrada" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="idProducto" class="form-label"></label>
            <select asp-for="idProducto" asp-items="Model.Productos" class="form-select">
                <option value="">-- Seleccionar --</option>
            </select>
            <span asp-validation-for="idProducto" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="idDepositoOrigen" class="form-label"></label>
            <select asp-for="idDepositoOrigen" asp-items="Model.Depositos" class="form-select">
                <option value="">-- Seleccionar --</option>
            </select>
            <span asp-validation-for="idDepositoOrigen" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="idProveedor" class="form-label"></label>
            <select asp-for="idProveedor" asp-items="Model.Proveedores" class="form-select">
                <option value="">-- Seleccionar --</option>
            </select>
            <span asp-validation-for="idProveedor" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Cantidad" class="form-label"></label>
            <input asp-for="Cantidad" type="number" min="1" class="form-control" />
            <span asp-validation-for="Cantidad" class="text-danger"></span>
        </div>
        <div class="col-12 mb-3">
            <label asp-for="Observaciones" class="form-label"></label>
            <textarea asp-for="Observaciones" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Observaciones" class="text-danger"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-success">Registrar entrada</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
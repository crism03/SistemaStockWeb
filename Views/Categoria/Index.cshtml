@model IEnumerable<SistemaStockWeb.Models.ViewModels.CategoriaViewModel>
@{
    ViewData["Title"] = "Categorías";
    ViewData["SubTitle"] = "Listado de categorías";
}

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Create" class="btn btn-sm btn-outline-primary">
        <i class="bi bi-plus"></i> Nueva categoría
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle" id="miTabla">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.Nombre)</th>
                <th>@Html.DisplayNameFor(m => m.Descripcion)</th>
                <th>@Html.DisplayNameFor(m => m.CantidadProductos)</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Descripcion</td>
                    <td>@item.CantidadProductos</td>
                    <td>
                        <span class="badge @(item.Activo ? "text-bg-success" : "text-bg-secondary")">@(item.Activo ? "Activa" : "Inactiva")</span>
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.id" class="btn btn-sm btn-outline-info" title="Ver">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.id" class="btn btn-sm btn-outline-primary" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.id" method="post"
                              class="d-inline form-eliminar" data-nombre="@item.Nombre">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-4">
    <i class="bi bi-exclamation-octagon text-danger" style="font-size: 3rem;"></i>
    <h3 class="mt-3">Ocurrió un error</h3>
    <p class="text-muted">No pudimos completar la operación. Intentá nuevamente o volvé al inicio.</p>
    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="small text-muted">Código de solicitud: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
</div>
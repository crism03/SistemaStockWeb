@model IEnumerable<SistemaStockWeb.Models.ViewModels.ProductoViewModel>
@{
    ViewData["Title"] = "Productos";
    ViewData["SubTitle"] = "Listado de productos";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <form method="get" class="row g-2">
        <div class="col-auto">
            <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control form-control-sm" placeholder="Buscar por nombre o código" />
        </div>
        <div class="col-auto">
            <select name="buscarCategoria" class="form-select form-select-sm" asp-items="ViewBag.Categorias">
                <option value="">Todas las categorías</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-secondary">Filtrar</button>
        </div>
    </form>
    <a asp-action="Create" class="btn btn-sm btn-outline-primary">
        <i class="bi bi-plus"></i> Nuevo producto
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle" id="miTabla">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.Codigo)</th>
                <th>@Html.DisplayNameFor(m => m.Nombre)</th>
                <th>@Html.DisplayNameFor(m => m.idCategoria)</th>
                <th>@Html.DisplayNameFor(m => m.UnidadDeMedida)</th>
                <th class="text-end">@Html.DisplayNameFor(m => m.PrecioCosto)</th>
                <th class="text-end">@Html.DisplayNameFor(m => m.PrecioVenta)</th>
                <th class="text-end">@Html.DisplayNameFor(m => m.StockMinimo)</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Codigo</td>
                    <td>@item.Nombre</td>
                    <td>@item.CategoriaNombre</td>
                    <td>@item.UnidadDeMedida</td>
                    <td class="text-end">@item.PrecioCosto.ToString("C2")</td>
                    <td class="text-end">@item.PrecioVenta.ToString("C2")</td>
                    <td class="text-end">@item.StockMinimo</td>
                    <td>
                        <span class="badge @(item.Activo ? "text-bg-success" : "text-bg-secondary")">@(item.Activo ? "Activo" : "Inactivo")</span>
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.id" class="btn btn-sm btn-outline-info" title="Ver">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.id" class="btn btn-sm btn-outline-primary" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.id" method="post"
                              class="d-inline form-eliminar" data-nombre="@item.Nombre">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@model SistemaStockWeb.Models.ViewModels.ProductoViewModel
@{
    ViewData["Title"] = "Productos";
    ViewData["SubTitle"] = "Eliminar producto";
}

<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle-fill me-2"></i>
    ¿Está seguro de que desea eliminar este producto? Esta acción no se puede deshacer.
    Si tiene movimientos o stock registrado, no podrá eliminarse.
</div>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Codigo)</dt>
    <dd class="col-sm-9">@(Model.Codigo ?? "-")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Nombre)</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.idCategoria)</dt>
    <dd class="col-sm-9">@Model.CategoriaNombre</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.UnidadDeMedida)</dt>
    <dd class="col-sm-9">@Model.UnidadDeMedida</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.id" method="post">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
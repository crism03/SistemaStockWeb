@model SistemaStockWeb.Models.ViewModels.ProveedorViewModel
@{
    ViewData["Title"] = "Proveedores";
    ViewData["SubTitle"] = "Detalle del proveedor";
}

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Nombre)</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Documento)</dt>
    <dd class="col-sm-9">@Model.Documento</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Contacto)</dt>
    <dd class="col-sm-9">@Model.Contacto</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Telefono)</dt>
    <dd class="col-sm-9">@Model.Telefono</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Email)</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Direccion)</dt>
    <dd class="col-sm-9">@Model.Direccion</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Observaciones)</dt>
    <dd class="col-sm-9">@Model.Observaciones</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">
        <span class="badge @(Model.Activo ? "text-bg-success" : "text-bg-secondary")">@(Model.Activo ? "Activo" : "Inactivo")</span>
    </dd>
</dl>

<div class="mt-3">

    <a asp-action="Delete" asp-route-id="@Model.id" class="btn btn-danger">Eliminar</a>
    <a asp-action="Edit" asp-route-id="@Model.id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>